# Set the public base URL of this single-endpoint service, without query/fragment.
# For Render, use your real service URL, e.g. https://your-service.onrender.com/
GROQ_API_KEY=your-groq-api-key
# Optional: comma/newline-separated fallback keys. Never commit real values.
GROQ_API_KEYS=
GROQ_KEYS_FILE=groqapikeys.txt
GROQ_MODEL=openai/gpt-oss-120b
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
DATABASE_PATH=./data/safe-ai-mailroom.sqlite3
MAX_REQUEST_BYTES=2097152
GROQ_MAX_TOKENS=2000
GROQ_BATCH_BYTES=8500
GROQ_MODEL_CONCURRENCY=2
LOG_LEVEL=INFO
# Optional secondary provider key. Set this only in Render/local environment;
# never put a live key in this example file.
GEMINI_API_KEY=your-gemini-api-key
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_BATCH_BYTES=150000
NVIDIA_MAX_TOKENS=8000
